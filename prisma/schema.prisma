// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// pm_db
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String // 'active' | 'completed' | 'on-hold'
  priority    String // 'low' | 'medium' | 'high'
  startDate   DateTime
  endDate     DateTime?
  progress    Int       @default(0)
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  title       String
  description String?
  status      String
  priority    String

  assigneeId String?
  assignee   TeamMember? @relation("TaskToAssignee", fields: [assigneeId], references: [id])

  dueDate   DateTime?
  tags      String[]
  arbetsorders Arbetsorder[] @relation("TaskToArbetsorder")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TeamMember {
  id     String @id @default(cuid())
  name   String
  email  String @unique
  role   String
  status String // 'active' | 'inactive'

  tasks Task[] @relation("TaskToAssignee")

  createdAt DateTime @default(now())
}

model Arbetsorder {
  id        String  @id @default(cuid())
  taskId    String?
  task      Task?   @relation("TaskToArbetsorder", fields: [taskId], references: [id])

  // Header fields
  workplace               String?
  street                  String?
  postalCode              String?
  city                    String?
  ourOrderNumber          String?
  customerOrderNumber     String?
  contactPersonTel        String?
  workType                String?

  // Work start checkboxes (stored as JSON array)
  workStartCheckboxes     String[]

  // Work completion checkboxes
  workCompletionCheckboxes String[]

  // Material usage
  materialUsageCheckboxes  String[]
  materialSpecification    String?  @db.Text

  // Risk assessment
  noSeriousRisksIdentified Boolean @default(false)
  risksIdentified          Boolean @default(false)
  riskContactNote          String?
  riskCategories           String[]
  controlledItems          String[]
  riskDescription          String?  @db.Text
  riskActionInstruction    String?  @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Customer {
  id                String   @id @default(cuid())
  customerName      String
  streetAddress     String?
  postalCode        String?
  city              String?
  contactPerson     String?
  contactPersonPhone String?
  contactPersonEmail String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
