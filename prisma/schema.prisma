generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// pm_db
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String // 'active' | 'completed' | 'on-hold'
  priority    String // 'low' | 'medium' | 'high'
  startDate   DateTime
  endDate     DateTime?
  progress    Int       @default(0)
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  title       String
  description String?
  status      String
  priority    String

  assigneeId String?
  assignee   TeamMember? @relation("TaskToAssignee", fields: [assigneeId], references: [id])

  dueDate   DateTime?
  tags      String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TeamMember {
  id     String @id @default(cuid())
  name   String
  email  String @unique
  role   String
  status String // 'active' | 'inactive'

  tasks Task[] @relation("TaskToAssignee")

  createdAt DateTime @default(now())
}
